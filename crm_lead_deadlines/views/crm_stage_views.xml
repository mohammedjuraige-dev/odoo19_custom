<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- CRM Stage Form View Inheritance -->
    <record id="crm_stage_view_form_inherit_deadline_sort" model="ir.ui.view">
        <field name="name">crm.stage.form.inherit.deadline.sort</field>
        <field name="model">crm.stage</field>
        <field name="inherit_id" ref="crm.crm_stage_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[1]" position="after">
                <group string="Pipeline Kanban Sorting">
                    <group>
                        <field name="deadline_sort_field_id"
                               options="{'no_create': True, 'no_open': True}"
                               placeholder="Default (Priority &amp; ID)"/>
                    </group>
                    <group>
                        <field name="deadline_sort_order"
                               invisible="not deadline_sort_field_id"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- CRM Stage Tree/List View Inheritance -->
    <record id="crm_stage_tree_view_inherit_deadline_sort" model="ir.ui.view">
        <field name="name">crm.stage.list.inherit.deadline.sort</field>
        <field name="model">crm.stage</field>
        <field name="inherit_id" ref="crm.crm_stage_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_won']" position="after">
                <field name="deadline_sort_field_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
